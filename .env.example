# ===== انسخ هذا الملف إلى .env محليًا، وضع نفس القيم في Vercel → Settings → Environment Variables =====

# إلزاميان: قاعدة Turso (أنشئها مجانًا على turso.tech)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-بصلاحيات-كتابة>

# اختياري: خدمة دمج الفيديو الخارجية (Video Merger API v2) — بدونها تبقى أدوات الدمج معطّلة برسالة واضحة
MERGER_API_BASE=

# اختياري: حماية /mcp بمفتاح Bearer (اتركه فارغًا للعام)
MCP_ACCESS_TOKEN=

# اختياري: حماية عمليات التعديل (إضافة/حذف المفاتيح) — يُرسل في ترويسة X-Admin-Token
ADMIN_TOKEN=

# اختياري: تجاوز الموديلات الافتراضية
DEAPI_IMAGE_MODEL=ZImageTurbo_INT8
DEAPI_VIDEO_MODEL=Ltx2_5_22B_Dist_INT8

# اختياري: تجاوز عنوان واجهة deAPI
DEAPI_BASE=https://api.deapi.ai/api/v2

# اختياري: نطاق عام لروابط فيديو Google Flow (الوسيط /api/gf/) —
# على Vercel يُستنتج تلقائيًا من VERCEL_PROJECT_PRODUCTION_URL؛ اضبطه للتشغيل المحلي فقط
GOOGLE_FLOW_PUBLIC_BASE=
