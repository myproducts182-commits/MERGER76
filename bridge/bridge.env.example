# ===== انسخ هذا الملف إلى bridge.env واملأ القيم =====
# عنوان خادم MERGER76 (لا تغيّره إلا إذا نشرت نسخة أخرى)
MERGER_URL=https://merger76.vercel.app

# نفس قيمة BRIDGE_TOKEN المضبوطة في Vercel → Settings → Environment Variables
BRIDGE_TOKEN=

# وضع الاختبار الآمن: 1 = محاكاة كاملة بلا Chrome وبلا أي استهلاك كريدتات
# بعد نجاح الاختبار (flow_probe يعمل) غيّرها إلى 0 للمتصفح الحقيقي
FAKE=1

# منفذ تصحيح المتصفح المخصص (غيّره فقط إذا كان مشغولًا)
CDP_PORT=9223

# اختياري: مسار Chrome يدويًا إن لم يوجد تلقائيًا
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
